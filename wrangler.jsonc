{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // wrangler.jsonc
  "name": "icy-math-d9e9",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB" }
  ],
  "kv_namespaces": [
    { "binding": "KV" }
  ],
  "workers_dev": true,
  "preview_urls": true,
{
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
}
